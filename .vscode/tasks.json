{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Preview website",
      "detail": "Builds the site and opens a live preview at http://localhost:8000",
      "type": "shell",
      "command": "uv",
      "args": ["run", "python", "scripts/build.py", "--serve"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "✔ Check projects",
      "detail": "Looks for mistakes in your project folders, in plain words",
      "type": "shell",
      "command": "uv",
      "args": ["run", "python", "scripts/build.py"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "⚙ Install (first time only)",
      "detail": "Installs locked dependencies and Chromium for browser tests",
      "type": "shell",
      "command": "uv",
      "args": ["run", "--locked", "python", "-m", "playwright", "install", "chromium"],
      "problemMatcher": []
    },
    {
      "label": "🧪 Run tests (advanced)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "--locked", "pytest", "-q"],
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
